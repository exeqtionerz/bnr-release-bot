# ─────────────────────────────────────────────────────────────
#  BNR Release Bot — copia este archivo como .env y rellénalo.
#  NUNCA subas el .env a GitHub (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Telegram (obligatorio) — token de @BotFather
TELEGRAM_BOT_TOKEN=
# Tu ID de Telegram (el bot solo te obedece a ti). Si lo dejas vacío,
# el bot te dice tu ID la primera vez que le escribas /start.
TELEGRAM_OWNER_ID=

# Dropbox (obligatorio) — app en https://www.dropbox.com/developers/apps
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# Carpeta raíz de lanzamientos (cada subcarpeta "Season X" contiene "BNR 0XX - Artista - Título")
DROPBOX_RELEASES_ROOT=/Break Neck Records/BNR RELEASES
# Carpeta donde el bot guarda los vídeos que genera (para Instagram necesita un enlace público temporal)
DROPBOX_OUTPUT_DIR=/Break Neck Records/BNR BOT
# Cada cuántos minutos mira si hay lanzamientos nuevos
WATCH_INTERVAL_MIN=15

# YouTube (opcional) — proyecto en Google Cloud con "YouTube Data API v3"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# private | unlisted | public  (privacidad por defecto; en el bot puedes elegir al publicar)
YOUTUBE_DEFAULT_PRIVACY=private

# Instagram (opcional) — cuenta profesional conectada a una página de Facebook + app de Meta
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# TikTok (opcional) — app en https://developers.tiktok.com con "Content Posting API"
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
# inbox = te llega como borrador a la app de TikTok y tú le das a publicar (funciona sin auditoría de TikTok)
# direct = publica directo (solo cuando TikTok haya aprobado tu app)
TIKTOK_MODE=inbox

# Duración máxima de Reels/TikToks generados (segundos)
REEL_MAX_SECONDS=60

# SoundCloud (opcional) — app en https://soundcloud.com/you/apps
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REFRESH_TOKEN=

# Textos con IA (opcional). Sin esto el bot usa plantillas.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Valores fijos que aparecen en los textos
LABEL_NAME=Break Neck Records
LABEL_HASHTAGS=#hardcore #uptempo #breakneckrecords #gabber #hardcoretechno
LABEL_LINKS=https://breakneckrecords.nl

# Puerto local para los scripts de autorización (npm run auth:*)
AUTH_PORT=8765
